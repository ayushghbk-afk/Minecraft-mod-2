{
  "format_version": "1.8.0",
  "animations": {
    "animation.humanoid.attack.rotations": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            "math.sin(variable.attack_time * 180.0) * 8.0",
            "math.sin(math.sqrt(variable.attack_time) * 360.0) * 22.0 - this",
            "math.sin(math.sqrt(variable.attack_time) * 360.0) * -4.0"
          ],
          "position": [
            0.0,
            "math.sin(variable.attack_time * 180.0) * -0.7",
            "math.sin(variable.attack_time * 180.0) * 1.6"
          ]
        },
        "head": {
          "rotation": [
            "math.sin(variable.attack_time * 180.0) * 10.0",
            "math.sin(math.sqrt(variable.attack_time) * 360.0) * 6.0",
            0.0
          ]
        },
        "leftarm": {
          "rotation": [
            "(math.sin((1.0 - math.pow(1.0 - variable.attack_time, 3.0)) * 180.0) * 1.25 + math.sin(variable.attack_time * 180.0) * 0.35) * 18.0",
            "math.sin(math.sqrt(variable.attack_time) * 360.0) * -8.0",
            "math.sin(variable.attack_time * 180.0) * 12.0"
          ]
        },
        "rightarm": {
          "rotation": [
            "(math.sin((1.0 - math.pow(1.0 - variable.attack_time, 3.0)) * 180.0) * 1.25 + math.sin(variable.attack_time * 180.0) * 0.35) * (variable.is_brandishing_spear || variable.is_holding_spyglass ? -70.0 : 78.0)",
            "variable.is_brandishing_spear || variable.is_holding_spyglass ? 0.0 : (math.sin(math.sqrt(variable.attack_time) * 360.0) * 28.0)",
            "math.sin(variable.attack_time * 180.0) * -16.0"
          ]
        },
        "leftleg": {
          "rotation": [
            "math.sin(variable.attack_time * 180.0) * -10.0",
            0.0,
            0.0
          ]
        },
        "rightleg": {
          "rotation": [
            "math.sin(variable.attack_time * 180.0) * 8.0",
            0.0,
            0.0
          ]
        }
      }
    },
    "animation.humanoid.move": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            "math.abs(variable.tcos0) * 0.04",
            "variable.tcos0 * 0.12",
            "variable.tcos0 * 0.05"
          ],
          "position": [
            0.0,
            "math.abs(variable.tcos0) * 0.018",
            0.0
          ]
        },
        "head": {
          "rotation": [
            "math.abs(variable.tcos0) * 0.03",
            0.0,
            "variable.tcos0 * -0.04"
          ]
        },
        "leftarm": {
          "rotation": [
            "variable.tcos0 * 1.35",
            0.0,
            "variable.tcos0 * 0.08"
          ]
        },
        "rightarm": {
          "rotation": [
            "-variable.tcos0 * 1.35",
            0.0,
            "variable.tcos0 * 0.08"
          ]
        },
        "leftleg": {
          "rotation": [
            "variable.tcos0 * -1.65",
            -0.1,
            -0.1
          ]
        },
        "rightleg": {
          "rotation": [
            "variable.tcos0 * 1.65",
            0.1,
            0.1
          ]
        }
      }
    },
    "animation.humanoid.bob": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            0.0,
            "math.sin(query.life_time * 90.0) * 0.28",
            0.0
          ]
        },
        "leftarm": {
          "rotation": [
            0.0,
            0.0,
            "((math.cos(query.life_time * 103.2) * 3.6) + 3.6) * -1.0"
          ]
        },
        "rightarm": {
          "rotation": [
            0.0,
            0.0,
            "(math.cos(query.life_time * 103.2) * 3.6) + 3.6"
          ]
        }
      }
    }
  }
}
